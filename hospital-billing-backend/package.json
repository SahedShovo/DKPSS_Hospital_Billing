    "@nestjs/platform-express": "^10.4.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.33.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
